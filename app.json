{
  "expo": {
    "name": "SaveDream-Front",
    "slug": "SaveDream-Front",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "savedreamfront",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
